<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>co.edu.javeriana</groupId>
        <artifactId>jee-presentacion</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>services</artifactId>
    <packaging>war</packaging>
    <name>Capa de Servicios (WildFly): REST + SOAP</name>

    <dependencies>
        <dependency>
            <groupId>co.edu.javeriana</groupId>
            <artifactId>contracts</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.platform</groupId>
            <artifactId>jakarta.jakartaee-api</artifactId>
        </dependency>

        <!-- Implementacion JAX-RS solo para ejecutar Response.status()/created() en JUnit. -->
        <!-- WildFly ya proporciona RESTEasy en produccion: no empaquetar esta dependencia. -->
        <dependency>
            <groupId>org.jboss.resteasy</groupId>
            <artifactId>resteasy-core</artifactId>
            <version>6.2.14.Final</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
        </dependency>
    </dependencies>

    <build>
        <!-- El nombre del WAR fija el módulo EJB en JNDI y el context root en WildFly -->
        <finalName>services</finalName>
    </build>
</project>
