# Log de acceso de Undertow en la consola de services, con el X-Correlation-ID que pone Kong.
# Sirve de evidencia para QA-SEG-1 (una petición rechazada en el gateway no aparece aquí) y para la trazabilidad.
embed-server --std-out=echo
/subsystem=undertow/server=default-server/http-listener=default:write-attribute(name=record-request-start-time,value=true)
/subsystem=undertow/server=default-server/host=default-host/setting=access-log:add(use-server-log=true,pattern="%h \"%r\" %s %b %Dms corr=%{i,X-Correlation-ID}")
stop-embedded-server
