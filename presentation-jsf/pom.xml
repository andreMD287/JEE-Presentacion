<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>co.edu.javeriana</groupId>
        <artifactId>jee-presentacion</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>presentation-jsf</artifactId>
    <packaging>war</packaging>
    <name>Capa de Presentacion (Tomcat): JSF</name>

    <dependencies>
        <dependency>
            <groupId>co.edu.javeriana</groupId>
            <artifactId>contracts</artifactId>
        </dependency>

        <!-- Tomcat no trae JSF ni CDI: van dentro del WAR -->
        <dependency>
            <groupId>org.glassfish</groupId>
            <artifactId>jakarta.faces</artifactId>
        </dependency>
        <dependency>
            <groupId>org.jboss.weld.servlet</groupId>
            <artifactId>weld-servlet-shaded</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
        </dependency>

        <!-- Cliente EJB remoto de WildFly (modo BACKEND_MODE=ejb) -->
        <dependency>
            <groupId>org.wildfly</groupId>
            <artifactId>wildfly-ejb-client-bom</artifactId>
            <type>pom</type>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
        </dependency>
    </dependencies>

    <build>
        <!-- En Tomcat el nombre del WAR es el context root: http://localhost:8080/recursos/ -->
        <finalName>recursos</finalName>
    </build>
</project>
