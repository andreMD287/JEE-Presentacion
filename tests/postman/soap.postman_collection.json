{
  "info": {
    "name": "Taller 4 - SOAP (RF-1..RF-5)",
    "description": "Servicio ResourceRequestSoapService de services (directo, sin gateway). Namespace http://recursos.javeriana.edu.co/soap. Contrato en docs/api.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
