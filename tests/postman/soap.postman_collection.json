  "item": [
    {
      "name": "WSDL publicado",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const wsdl = pm.response.text();",
              "pm.test(\"es un WSDL del namespace acordado\", () => pm.expect(wsdl).to.include('targetNamespace=\"http://recursos.javeriana.edu.co/soap\"'));",
              "[\"registerRequest\", \"listRequests\", \"getRequest\", \"attendRequest\", \"listPendingRequests\"].forEach(op =>",
              "  pm.test(\"expone \" + op, () => pm.expect(wsdl).to.include('name=\"' + op + '\"')));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{soapUrl}}?wsdl"
      }
    },
    {
      "name": "RF-1 registerRequest válida",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const xml = pm.response.text();",
              "const all = tag => [...xml.matchAll(new RegExp(\"<(?:\\\\w+:)?\" + tag + \">([^<]*)</(?:\\\\w+:)?\" + tag + \">\", \"g\"))].map(m => m[1]);",
              "const one = tag => all(tag)[0];",
              "",
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"nace PENDIENTE\", () => pm.expect(one(\"status\")).to.eql(\"PENDIENTE\"));",
              "pm.test(\"tiene id\", () => pm.expect(Number(one(\"id\"))).to.be.above(0));",
              "pm.collectionVariables.set(\"soapId\", one(\"id\"));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "text/xml; charset=utf-8"
          },
          {
            "key": "SOAPAction",
            "value": "\"\""
          }
        ],
        "url": "{{soapUrl}}",
        "body": {
          "mode": "raw",
          "raw": "<soapenv:Envelope xmlns:soapenv=\"http://schemas.xmlsoap.org/soap/envelope/\" xmlns:r=\"http://recursos.javeriana.edu.co/soap\">\n  <soapenv:Header/>\n  <soapenv:Body>\n    <r:registerRequest>\n      <request>\n        <disasterDescription>Sismo en Pasto {{$timestamp}}</disasterDescription>\n        <resourceType>Medicamentos</resourceType>\n        <quantity>40</quantity>\n        <priority>ALTA</priority>\n      </request>\n    </r:registerRequest>\n  </soapenv:Body>\n</soapenv:Envelope>"
        }
      }
    },
