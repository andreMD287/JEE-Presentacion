        ],
        "url": "{{baseUrl}}/requests",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"disasterDescription\": \"Incendio forestal\",\n  \"resourceType\": \"Carpas\",\n  \"quantity\": 0,\n  \"priority\": \"MEDIA\"\n}"
        }
      }
    },
