              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"la atendida salió de pendientes\", () =>",
              "  pm.expect(pm.response.json().map(r => r.id)).to.not.include(pm.collectionVariables.get(\"id\")));"
