{
  "info": {
    "name": "Taller 4 - REST (RF-1..RF-5)",
    "description": "Operaciones REST de services. Se corre contra el gateway (entorno gateway) o directo contra services (entorno directo). Contrato en docs/api.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "RF-1 Registrar solicitud válida",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "const r = pm.response.json();",
              "pm.test(\"nace PENDIENTE\", () => pm.expect(r.status).to.eql(\"PENDIENTE\"));",
              "pm.test(\"tiene id\", () => pm.expect(r.id).to.be.a(\"number\"));",
              "pm.test(\"devuelve los datos enviados\", () => {",
              "  pm.expect(r.resourceType).to.eql(\"Agua potable\");",
              "  pm.expect(r.quantity).to.eql(120);",
              "  pm.expect(r.priority).to.eql(\"ALTA\");",
              "});",
              "pm.test(\"cabecera Location\", () => pm.expect(pm.response.headers.get(\"Location\")).to.include(\"/requests/\" + r.id));",
              "pm.collectionVariables.set(\"id\", r.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "apikey",
            "value": "{{apiKey}}"
          }
        ],
        "url": "{{baseUrl}}/requests",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"disasterDescription\": \"Inundación en Mocoa {{$timestamp}}\",\n  \"resourceType\": \"Agua potable\",\n  \"quantity\": 120,\n  \"priority\": \"ALTA\"\n}"
        }
      }
    },
    {
      "name": "RF-1 Regla: cantidad 0",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));",
              "pm.test(\"código VALIDATION_ERROR\", () => pm.expect(pm.response.json().code).to.eql(\"VALIDATION_ERROR\"));",
              "pm.test(\"cuerpo de error del T2\", () => pm.expect(pm.response.json()).to.have.keys(\"code\", \"message\", \"timestamp\"));",
              "pm.test(\"mensaje de negocio\", () => pm.expect(pm.response.json().message).to.eql(\"La cantidad debe ser mayor que cero\"));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "apikey",
            "value": "{{apiKey}}"
