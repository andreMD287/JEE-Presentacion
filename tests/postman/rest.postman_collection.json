    {
      "name": "RF-3 Solicitud inexistente",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 404\", () => pm.response.to.have.status(404));",
              "pm.test(\"código REQUEST_NOT_FOUND\", () => pm.expect(pm.response.json().code).to.eql(\"REQUEST_NOT_FOUND\"));",
              "pm.test(\"cuerpo de error del T2\", () => pm.expect(pm.response.json()).to.have.keys(\"code\", \"message\", \"timestamp\"));",
              "pm.test(\"mensaje de negocio\", () => pm.expect(pm.response.json().message).to.eql(\"No existe la solicitud con id 999999999\"));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "apikey",
            "value": "{{apiKey}}"
          }
        ],
        "url": "{{baseUrl}}/requests/999999999"
      }
    },
    {
      "name": "RF-5 Pendientes incluye la nueva",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const list = pm.response.json();",
              "pm.test(\"solo PENDIENTE\", () => list.forEach(r => pm.expect(r.status).to.eql(\"PENDIENTE\")));",
              "pm.test(\"incluye la registrada\", () =>",
              "  pm.expect(list.map(r => r.id)).to.include(pm.collectionVariables.get(\"id\")));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "apikey",
            "value": "{{apiKey}}"
          }
        ],
        "url": "{{baseUrl}}/requests/pending"
      }
    },
